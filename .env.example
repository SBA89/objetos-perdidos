# Copie este archivo como ".env" y complete los valores. NUNCA suba ".env" a un repositorio.

# --- Servidor ---
PORT=3000
# Debe ser una cadena larga y aleatoria (mínimo 32 caracteres). Ejemplo para generarla:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# true solo si se sirve por HTTPS; en la demostración local (http://localhost) debe ser false
COOKIE_SECURE=false
AUDITORIA_RUTA=./auditoria_logs.txt

# --- PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=objetos_perdidos
DB_USER=
DB_PASSWORD=

# --- Solo para pruebas de integración (base de datos SEPARADA, se vacía en cada ejecución) ---
TEST_DB_NAME=objetos_perdidos_test
