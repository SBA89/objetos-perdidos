{
  "name": "objetos-perdidos-registrar-objeto",
  "version": "1.0.0",
  "description": "Módulo 'Registrar objeto encontrado' del Sistema de Gestión de Objetos Perdidos (Universidad Católica Luis Amigó)",
  "private": true,
  "main": "dist/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "npm run build && node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "tsx --test \"test/unit/*.test.ts\"",
    "test:integration": "tsx --test \"test/integration/*.test.ts\"",
    "test:all": "tsx --test \"test/unit/*.test.ts\" \"test/integration/*.test.ts\"",
    "db:init": "tsx src/database/initDb.ts",
    "db:init:test": "tsx src/database/initDb.ts --test",
    "set-password": "tsx src/database/setPassword.ts",
    "medir": "tsx scripts/medirRendimiento.ts"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.18.0",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
